<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/webp" href="/images/CheatCodeIARE.webp">
    <script>
        (function () {
            const theme = localStorage.getItem('cheatcode-theme');
            const normalized = theme === 'light' ? 'light' : 'dark';
            document.documentElement.dataset.theme = normalized;
            document.documentElement.style.colorScheme = normalized;
        })();
    </script>
    <title>Generate PPT - CheatCodeIARE</title>
    <link rel="stylesheet" href="/styles/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .ppt-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.03);
            padding: 40px;
            border-radius: 15px;
            border: 2px solid #ff00ff;
            box-shadow: 0 0 15px rgba(255, 0, 255, 0.2);
            backdrop-filter: blur(10px);
            max-width: 600px;
            width: 100%;
            margin: 20px;
        }

        .ppt-title {
            font-family: 'Orbitron', sans-serif;
            color: #fff;
            text-shadow: 0 0 10px #ff00ff;
            margin-bottom: 30px;
            font-size: 2rem;
            text-align: center;
        }

        .user-info {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
            width: 100%;
            justify-content: space-between;
        }

        .info-box {
            background: rgba(0, 0, 0, 0.5);
            padding: 10px 20px;
            border: 1px solid #39ff14;
            color: #39ff14;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.9rem;
            border-radius: 5px;
            flex: 1;
            text-align: center;
        }

        .input-group {
            width: 100%;
            margin-bottom: 20px;
        }

        .input-group label {
            display: block;
            color: #ff00ff;
            font-family: 'Orbitron', sans-serif;
            margin-bottom: 8px;
            font-size: 0.9rem;
        }

        .input-group input,
        .input-group textarea {
            width: 100%;
            padding: 12px;
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid #333;
            border-radius: 5px;
            color: #fff;
            font-family: 'Poppins', sans-serif;
            font-size: 1rem;
            outline: none;
            box-sizing: border-box;
            transition: all 0.3s ease;
        }

        .input-group input:focus,
        .input-group textarea:focus {
            border-color: #39ff14;
            box-shadow: 0 0 10px rgba(57, 255, 20, 0.3);
        }

        .generate-btn {
            width: 100%;
            padding: 15px;
            background: transparent;
            color: #39ff14;
            border: 2px solid #39ff14;
            font-family: 'Orbitron', sans-serif;
            font-weight: bold;
            font-size: 1.2rem;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 10px;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .generate-btn:hover {
            background: #39ff14;
            color: #050505;
            box-shadow: 0 0 20px rgba(57, 255, 20, 0.8);
        }

        .loading {
            display: none;
            color: #39ff14;
            margin-top: 15px;
            font-family: 'Orbitron', sans-serif;
            font-size: 1rem;
            text-align: center;
            text-shadow: 0 0 10px rgba(57, 255, 20, 0.5);
        }

        .loading i {
            margin-left: 10px;
            font-size: 1.2rem;
            display: inline-block;
            animation: fa-spin 2s infinite linear;
            color: #39ff14;
        }

        @keyframes fa-spin {
            0%   { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        @media (max-width: 600px) {
            .ppt-container {
                padding: 24px 16px;
                margin: 10px;
                border-radius: 12px;
            }
            .ppt-title {
                font-size: 1.4rem;
                margin-bottom: 20px;
            }
            .user-info {
                flex-direction: column;
                gap: 10px;
            }
            .info-box {
                font-size: 0.78rem;
                padding: 8px 12px;
            }
            .input-group label {
                font-size: 0.78rem;
            }
            .input-group input,
            .input-group textarea {
                font-size: 0.95rem;
                padding: 13px 10px;
            }
            .generate-btn {
                padding: 16px;
                font-size: 1rem;
            }
            .loading {
                font-size: 0.85rem;
            }
        }

        html[data-theme="light"] .ppt-container {
            background: rgba(255, 255, 255, 0.76);
            box-shadow: 0 22px 48px rgba(18, 32, 51, 0.14);
        }

        html[data-theme="light"] .ppt-title {
            color: var(--text);
            text-shadow: 0 0 10px rgba(204, 46, 194, 0.18);
        }

        html[data-theme="light"] .info-box {
            background: rgba(255, 255, 255, 0.9);
            border-color: var(--accent-lime);
            color: var(--accent-lime);
        }

        html[data-theme="light"] .input-group label {
            color: var(--accent-magenta);
        }

        html[data-theme="light"] .input-group input,
        html[data-theme="light"] .input-group textarea {
            background: var(--surface-input);
            border-color: var(--surface-border-strong);
            color: var(--field-text);
        }

        html[data-theme="light"] .input-group input::placeholder,
        html[data-theme="light"] .input-group textarea::placeholder {
            color: var(--placeholder-text);
        }

        html[data-theme="light"] .generate-btn:hover {
            color: var(--bg);
        }

        html[data-theme="light"] .loading {
            color: var(--accent-lime);
            text-shadow: none;
        }
        /* ── API Key Configuration Section ────────────────────────────────── */
        .api-section-card {
            background: rgba(0, 243, 255, 0.03);
            border: 1px solid rgba(0, 243, 255, 0.3);
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
            margin-bottom: 24px;
            box-shadow: 0 0 15px rgba(0, 243, 255, 0.08);
            transition: all 0.3s ease;
            text-align: left;
        }

        .api-section-card:hover {
            border-color: #00f3ff;
            box-shadow: 0 0 20px rgba(0, 243, 255, 0.15);
        }

        .api-section-header {
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.9rem;
            color: #00f3ff;
            margin-bottom: 16px;
            letter-spacing: 1px;
        }

        .api-section-header .api-icon {
            font-size: 1.1rem;
            color: #ff00ff;
        }

        .api-badge {
            margin-left: auto;
            font-size: 0.68rem;
            background: rgba(255, 0, 255, 0.15);
            color: #ff00ff;
            border: 1px solid #ff00ff;
            padding: 2px 8px;
            border-radius: 4px;
            font-family: 'Share Tech Mono', monospace;
            letter-spacing: 1px;
        }

        .api-input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }

        .api-input-wrapper input {
            padding-right: 45px !important;
        }

        .toggle-key-btn {
            position: absolute;
            right: 12px;
            background: transparent;
            border: none;
            color: #888;
            cursor: pointer;
            font-size: 1.1rem;
            padding: 6px;
            transition: color 0.2s;
        }

        .toggle-key-btn:hover {
            color: #00f3ff;
        }

        .api-instructions-box {
            background: rgba(0, 0, 0, 0.45);
            border-left: 3px solid #ff00ff;
            padding: 14px 16px;
            border-radius: 0 6px 6px 0;
            margin-top: 14px;
        }

        .instruction-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            color: #fff;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .instruction-title i {
            color: #00f3ff;
        }

        .instruction-list {
            margin-left: 20px;
            color: #bbb;
            font-size: 0.82rem;
            line-height: 1.6;
            margin-bottom: 14px;
        }

        .instruction-list strong {
            color: #fff;
        }

        .instruction-footer {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .ai-studio-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: rgba(255, 0, 255, 0.15);
            border: 1px solid #ff00ff;
            color: #ff00ff;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.78rem;
            font-weight: 700;
            padding: 10px 16px;
            border-radius: 6px;
            text-decoration: none;
            letter-spacing: 0.8px;
            transition: all 0.3s ease;
            text-transform: uppercase;
        }

        .ai-studio-btn:hover {
            background: #ff00ff;
            color: #000;
            box-shadow: 0 0 15px rgba(255, 0, 255, 0.5);
            transform: translateY(-1px);
        }

        .api-note-text {
            font-size: 0.75rem;
            color: #777;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .api-note-text i {
            color: #39ff14;
        }

        /* Light Mode styles for API Section */
        html[data-theme="light"] .api-section-card {
            background: rgba(0, 168, 204, 0.05);
            border-color: rgba(0, 168, 204, 0.3);
        }

        html[data-theme="light"] .api-section-header {
            color: var(--accent-cyan);
        }

        html[data-theme="light"] .api-badge {
            background: rgba(186, 0, 255, 0.1);
            color: var(--accent-magenta);
            border-color: var(--accent-magenta);
        }

        html[data-theme="light"] .api-instructions-box {
            background: var(--surface-panel);
            border-left-color: var(--accent-magenta);
        }

        html[data-theme="light"] .instruction-title {
            color: var(--text);
        }

        html[data-theme="light"] .instruction-list {
            color: var(--muted-text);
        }

        html[data-theme="light"] .instruction-list strong {
            color: var(--text);
        }

        html[data-theme="light"] .ai-studio-btn {
            background: rgba(186, 0, 255, 0.1);
            border-color: var(--accent-magenta);
            color: var(--accent-magenta);
        }

        html[data-theme="light"] .ai-studio-btn:hover {
            background: var(--accent-magenta);
            color: #ffffff;
            box-shadow: 0 8px 20px rgba(186, 0, 255, 0.3);
        }

        html[data-theme="light"] .api-note-text {
            color: var(--soft-text);
        }
    </style>
</head>

<body>
    <!-- Persistent Header -->
    <div class="header">
        <div class="headerLeft" style="cursor: pointer;" onclick="window.location.href='/'">
            <img src="/images/CheatCodeIARE.webp" alt="img" class="logo">
            <p class="title">CheatCodeIARE</p>
        </div>
        <div class="headerRight">
            <button type="button" class="theme-toggle" data-theme-toggle>
                <i class="theme-toggle-icon fa-solid fa-sun"></i>
                <span class="theme-toggle-label">Light Mode</span>
            </button>
            <button class="signupbtn" onclick="window.location.href='/'">HOME</button>
        </div>
    </div>

    <div class="content">
        <div class="ppt-container">
            <h1 class="ppt-title">PPT GENERATOR</h1>

            <div class="user-info">
                <div class="info-box">Name: <%= user.name %>
                </div>
                <div class="info-box">ID: <%= user.studentId %>
                </div>
            </div>

            <form id="pptForm" action="/generate-ppt" method="POST">
                <div class="input-group">
                    <label>Department</label>
                    <input type="text" name="department" required placeholder="e.g. CSE">
                </div>
                <div class="input-group">
                    <label>Subject</label>
                    <input type="text" name="subject" required placeholder="e.g. Artificial Intelligence">
                </div>
                <div class="input-group">
                    <label>Problem Statement</label>
                    <textarea name="problemStatement" rows="4" required placeholder="Describe your topic..."></textarea>
                </div>

                <!-- API Key Section -->
                <div class="api-section-card">
                    <div class="api-section-header">
                        <i class="fa-solid fa-key api-icon"></i>
                        <span>GEMINI API CONFIGURATION</span>
                        <span class="api-badge">REQUIRED</span>
                    </div>

                    <div class="input-group" style="margin-bottom: 10px;">
                        <label for="apiKey">Paste Your Gemini API Key <span style="color:#ff00ff;">*</span></label>
                        <div class="api-input-wrapper">
                            <input type="password" id="apiKey" name="apiKey" required placeholder="Paste your Gemini API key (e.g. AIzaSy...)" autocomplete="off">
                            <button type="button" class="toggle-key-btn" id="toggleKeyBtn" title="Show/Hide API Key">
                                <i class="fa-solid fa-eye" id="toggleKeyIcon"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Instructions Box -->
                    <div class="api-instructions-box">
                        <div class="instruction-title">
                            <i class="fa-solid fa-circle-info"></i> How to get your free Gemini API key:
                        </div>
                        <ol class="instruction-list">
                            <li>Open <strong>Google AI Studio</strong> using the button below.</li>
                            <li>Sign in with your Google Account.</li>
                            <li>Click on <strong>"Create API key"</strong>.</li>
                            <li>Copy your API key and paste it in the field above.</li>
                        </ol>
                        <div class="instruction-footer">
                            <a href="https://aistudio.google.com/app/apikey" target="_blank" rel="noopener noreferrer" class="ai-studio-btn">
                                <i class="fa-solid fa-arrow-up-right-from-square"></i> GET GEMINI API KEY FROM GOOGLE AI STUDIO
                            </a>
                        </div>
                    </div>
                </div>

                <button type="submit" class="generate-btn" id="generateBtn">
                    <i class="fa-solid fa-bolt"></i> GENERATE PPT
                </button>
                <div id="loading" class="loading">Generating Cybernetic Content... <i
                        class="fa-solid fa-spinner fa-spin"></i></div>
            </form>
            <!-- Adsterra Native Banner -->
            <div class="ad-wrapper">
                <p class="ad-label">❤️ Support CheatCodeIARE</p>
                <img src="/images/Donate.webp" alt="Donate to CheatCodeIARE" class="donate-img">
            </div>
        </div>
    </div>

    <script>
        document.getElementById('toggleKeyBtn').addEventListener('click', function () {
            const input = document.getElementById('apiKey');
            const icon = document.getElementById('toggleKeyIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        });

        document.getElementById('pptForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const btn = document.getElementById('generateBtn');
        const loading = document.getElementById('loading');
        if (btn.disabled) return;
        btn.disabled = true;
        btn.style.display = 'none';
        loading.style.display = 'block';

        const body = new URLSearchParams(new FormData(this)).toString();
        try {
            const res  = await fetch('/generate-ppt', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'Accept': 'application/json'
                },
                body
            });

            if (res.redirected) {
                window.location.href = res.url;
                return;
            }

            const contentType = res.headers.get('content-type') || '';
            if (!contentType.includes('application/json')) {
                throw new Error('Session expired. Please log in again.');
            }

            const data = await res.json();
            if (!res.ok) {
                loading.textContent = 'âŒ ' + (data.error || 'Unknown error');
                btn.disabled = false;
                btn.style.display = 'flex';
                return;
            }
            if (data.queued) { window.location.href = '/queue'; }
            else { loading.textContent = '❌ ' + (data.error || 'Unknown error'); btn.disabled = false; btn.style.display = 'flex'; }
        } catch (err) {
            loading.textContent = '❌ ' + (err.message || 'Request failed. Please try again.');
            btn.disabled = false; btn.style.display = 'flex';
        }
    });
    </script>
    <script defer src="/js/theme.js"></script>

    <!-- Vercel Web Analytics -->
    <script>
        window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments) };
    </script>
    <script defer src="/_vercel/insights/script.js"></script>
</body>

</html>
